# ==============================================================================
# StockPulse AI - Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=stockpulse-ai

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=stockpulse
POSTGRES_PASSWORD=your_secure_dev_password
POSTGRES_DB=stockpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://stockpulse:your_secure_dev_password@localhost:5432/stockpulse_db

# Redpanda / Kafka Streaming
REDPANDA_BROKERS=localhost:9092
KAFKA_TOPIC_OHLCV=stockpulse.ohlcv.daily
KAFKA_CONSUMER_GROUP=stockpulse-consumer-group

# MLflow Experiment Tracking (Local SQLite + Artifact Directory)
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000

# Configuration Selection
# Options: "dev" (10 tickers) or "nifty50" (full 50 tickers)
ACTIVE_UNIVERSE=dev
